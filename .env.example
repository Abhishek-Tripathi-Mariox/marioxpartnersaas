# MongoDB connection string (local or Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/mariox

# Long random string used to sign login sessions (openssl rand -hex 32)
JWT_SECRET=change-me-to-a-long-random-string

# Secret your main website sends in the x-api-key header to create users
MAIN_SITE_API_KEY=testingmodemariox

# Public URL of this app (used to build set-password links)
APP_URL=http://localhost:3000

# Allowed origin of your main website for CORS on /api/v1/* (comma separated)
MAIN_SITE_ORIGIN=http://localhost:5173

# First admin account, created by `npm run seed`
ADMIN_EMAIL=admin@mariox.in
ADMIN_PASSWORD=Admin@12345
ADMIN_NAME=Mariox Admin
